# Copy to .env and generate two different random values before starting.
TASKBOARD_JWT_SECRET=
DJANGO_SECRET_KEY=

# Local development; use explicit hosts and HTTPS settings for deployment.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
TASKBOARD_API_URL=http://127.0.0.1:8080/

# AI: demo uses deterministic sample tasks; ollama enables real generation.
TASKBOARD_AI_PROVIDER=demo
TASKBOARD_AI_BASE_URL=http://127.0.0.1:11434
# Required for ollama: select a model already installed (`ollama list`).
TASKBOARD_AI_MODEL=
# Model request timeout in seconds, from 1 to 300.
TASKBOARD_AI_TIMEOUT=60

# Optional SQLite URL. The default is backend/taskboard_dev.db.
# TASKBOARD_DATABASE_URL=sqlite:///C:/absolute/path/to/taskboard.db

# Enable only behind a correctly configured HTTPS endpoint.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_HSTS_SECONDS=0
